# 服务配置示例。
#
# 本模板**不读取 .env 文件**，配置一律来自进程环境变量。
# 本地开发时可以直接 `make run`（会自动注入 AUTH_TOKEN=dev-token-12345），
# 部署时由 K8s / 容器平台 / CI 注入。
#
# 复制本文件为 .env 仅作参考，请勿提交真实密钥。

# HTTP 监听地址。容器内建议 :8080。
HTTP_ADDR=:8080

# 必填：Bearer Token，至少 8 个字符。
# 生产环境请替换为真实鉴权（JWT/OIDC）并删除此变量，见 docs/extending.md。
AUTH_TOKEN=dev-token-12345

# development 输出可读文本日志 + debug 级别；其他值输出 JSON 日志。
APP_ENV=development

# debug / info / warn / error
LOG_LEVEL=info

# 优雅关闭的最长等待时间。
SHUTDOWN_TIMEOUT=10s

# net/http.Server 超时配置（防慢速攻击）。
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
